# Database Configuration
DATABASE_URL="postgresql://user:password@host:port/database"

# Stripe Configuration (Optional)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."

# JWT Configuration for Public Authentication
JWT_SECRET="your-secret-key-change-in-production-min-32-chars"



# Server Configuration
PORT=5000
NODE_ENV=development
# Access Control & Encryption
ENC_KEY=32-byte-hex-key-for-encryption
DIALER_PROVIDER=twilio
CALLS_POLL_SECONDS=10

# Dialer Integrations
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WORKSPACE_SID=your_twilio_workspace_sid

FIVE9_CLIENT_ID=your_five9_client_id
FIVE9_CLIENT_SECRET=your_five9_client_secret

RINGCENTRAL_CLIENT_ID=your_ringcentral_client_id
RINGCENTRAL_CLIENT_SECRET=your_ringcentral_client_secret

# Stripe (if not already present)
STRIPE_SECRET_KEY=your_stripe_secret_key
