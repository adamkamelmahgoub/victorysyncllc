{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "redirects": [
    {
      "source": "/about",
      "destination": "/about-us",
      "statusCode": 301
    }
  ],
  "routes": [
    {
      "src": "^/(?:blog(?:/(?:reduce-customer-service-costs|ai-automation-vs-human-touch|when-to-outsource-call-center|building-customer-loyalty|scaling-outsourced-support|roi-of-customer-service))?|careers|docs)/?$",
      "status": 410
    }
  ],
  "headers": [
    {
      "source": "/(cms|cms.html)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; connect-src 'self' https://api.github.com; img-src 'self' data: https:; frame-src 'self'; frame-ancestors 'none'; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/(login|register|signup|checkout|dashboard|cms|cms.html)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/cms", "destination": "/cms.html" },
    { "source": "/services", "destination": "/services/index.html" },
    { "source": "/how-it-works", "destination": "/how-it-works/index.html" },
    { "source": "/faq", "destination": "/faq/index.html" },
    { "source": "/clients", "destination": "/clients/index.html" },
    { "source": "/appointment-setting", "destination": "/appointment-setting/index.html" },
    { "source": "/cold-calling", "destination": "/cold-calling/index.html" },
    { "source": "/inbound-support", "destination": "/inbound-support/index.html" },
    { "source": "/ai-automation", "destination": "/ai-automation/index.html" },
    { "source": "/digital-marketing", "destination": "/digital-marketing/index.html" },
    { "source": "/pricing", "destination": "/pricing/index.html" },
    { "source": "/platform", "destination": "/platform/index.html" },
    { "source": "/about-us", "destination": "/about-us/index.html" },
    { "source": "/contact", "destination": "/contact/index.html" },
    { "source": "/book-call", "destination": "/book-call/index.html" },
    { "source": "/help-center", "destination": "/help-center/index.html" },
    { "source": "/reviews", "destination": "/reviews/index.html" },
    { "source": "/privacy-policy", "destination": "/privacy-policy/index.html" },
    { "source": "/terms", "destination": "/terms/index.html" },
    { "source": "/appointment-setting-for-home-services", "destination": "/appointment-setting-for-home-services/index.html" },
    { "source": "/cold-calling-for-plumbers", "destination": "/cold-calling-for-plumbers/index.html" },
    { "source": "/answering-service-for-plumbers", "destination": "/answering-service-for-plumbers/index.html" },
    { "source": "/appointment-setting-for-hvac", "destination": "/appointment-setting-for-hvac/index.html" },
    { "source": "/appointment-setting-for-real-estate", "destination": "/appointment-setting-for-real-estate/index.html" },
    { "source": "/inbound-support-for-law-firms", "destination": "/inbound-support-for-law-firms/index.html" },
    { "source": "/(login|register|signup|checkout|dashboard)", "destination": "/index.html" }
  ]
}
