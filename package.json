{
  "name": "victorysync",
  "private": true,
    {
      "scripts": {
        // one command to start both
        "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",

        // Vite front-end
        "dev:client": "vite",

        // 🔥 backend (adjust path if different!)
        "dev:server": "ts-node-dev --respawn --transpile-only --esm server/index.ts",

        // production build + start (optional)
        "build": "vite build && tsc -p tsconfig.json",
        "start": "node dist/server/index.js"
      }
    }

    "preview": "vite preview"
  },
