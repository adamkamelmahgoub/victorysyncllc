
{
  "name": "VictorySync AI Suite",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "/vs-ai-webhook",
        "options": {}
      },
      "id": "webhook-start",
      "name": "Webhook Start",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300],
      "webhookId": "vs-ai-suite"
    },
    {
      "parameters": {
        "model": "gpt-4-turbo-preview",
        "messages": {
          "messageValues": [
            {
              "role": "system",
              "message": "Classify this customer inquiry into one of these categories: billing, technical, sales, general. Return only the category name."
            },
            {
              "role": "user", 
              "message": "={{ $json.message }}"
            }
          ]
        }
      },
      "id": "classify-intent",
      "name": "Classify Intent",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.3,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "high-confidence",
              "leftValue": "={{ $json.confidence }}",
              "rightValue": 0.8,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "confidence-check",
      "name": "Confidence Check",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "url": "={{ $vars.KB_ENDPOINT }}/search",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $vars.KB_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "query",
              "value": "={{ $json.message }}"
            },
            {
              "name": "category",
              "value": "={{ $('Classify Intent').item.json.category }}"
            }
          ]
        }
      },
      "id": "search-kb",
      "name": "Search Knowledge Base",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [900, 200]
    },
    {
      "parameters": {
        "model": "gpt-4-turbo-preview",
        "messages": {
          "messageValues": [
            {
              "role": "system",
              "message": "You are a VictorySync customer service assistant. Use the knowledge base context to draft a helpful response. Be professional and concise."
            },
            {
              "role": "user",
              "message": "Customer inquiry: {{ $('Webhook Start').item.json.message }}\n\nKB Context: {{ $json.results }}\n\nDraft a response:"
            }
          ]
        }
      },
      "id": "draft-response",
      "name": "Draft Response",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.3,
      "position": [1120, 200]
    },
    {
      "parameters": {
        "url": "={{ $vars.CRM_WEBHOOK }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $vars.CRM_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "contact_id",
              "value": "={{ $('Webhook Start').item.json.contactId }}"
            },
            {
              "name": "category", 
              "value": "={{ $('Classify Intent').item.json.category }}"
            },
            {
              "name": "confidence",
              "value": "={{ $('Classify Intent').item.json.confidence }}"
            },
            {
              "name": "response",
              "value": "={{ $json.response }}"
            }
          ]
        }
      },
      "id": "log-to-crm",
      "name": "Log to CRM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1340, 200]
    },
    {
      "parameters": {
        "url": "={{ $vars.EMAIL_OUTBOUND_ENDPOINT }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $vars.EMAIL_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "to",
              "value": "={{ $('Webhook Start').item.json.customerEmail }}"
            },
            {
              "name": "subject",
              "value": "Re: Your VictorySync Inquiry"
            },
            {
              "name": "body",
              "value": "={{ $('Draft Response').item.json.response }}"
            }
          ]
        }
      },
      "id": "send-email",
      "name": "Send Email Response",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1560, 200]
    },
    {
      "parameters": {
        "url": "={{ $vars.CRM_WEBHOOK }}/escalate",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization", 
              "value": "Bearer {{ $vars.CRM_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "contact_id",
              "value": "={{ $('Webhook Start').item.json.contactId }}"
            },
            {
              "name": "message",
              "value": "={{ $('Webhook Start').item.json.message }}"
            },
            {
              "name": "reason",
              "value": "Low confidence classification"
            }
          ]
        }
      },
      "id": "escalate",
      "name": "Escalate to Human",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [900, 400]
    }
  ],
