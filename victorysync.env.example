
# VictorySync Production Environment Variables

# Twilio Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# HubSpot Integration
HUBSPOT_TOKEN=your_hubspot_private_app_token
HS_APP_SECRET=your_hubspot_app_secret_for_webhook_validation

# Email Providers
RESEND_API_KEY=your_resend_api_key
POSTMARK_API_KEY=your_postmark_api_key

# n8n AI Suite Variables (set these in n8n Variables section)
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/vs-ai-suite
OPENAI_API_KEY=your_openai_api_key
KB_ENDPOINT=https://your-knowledge-base-api.com
KB_TOKEN=your_kb_api_token
EMAIL_OUTBOUND_ENDPOINT=https://api.resend.com/emails
EMAIL_TOKEN=your_email_api_token
CRM_WEBHOOK=https://your-app.replit.dev/api/crm-webhook
CRM_TOKEN=your_internal_crm_token

# Report Generation
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# Organization Settings
DEFAULT_TIMEZONE=America/New_York

# Feature Flags
ENABLE_IVR_ROUTING=true
ENABLE_AI_SUITE=true
ENABLE_ADVANCED_REPORTING=true
ENABLE_HUBSPOT_SYNC=true
